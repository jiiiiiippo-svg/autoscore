# ── Supabase ──────────────────────────────────────────────
# Settings → API → Project URL + anon public key
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Settings → API → service_role key (jamais exposée côté client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Apify ─────────────────────────────────────────────────
# apify.com → Settings → Integrations → API token
APIFY_TOKEN=apify_api_XXXXXXXXXXXXXXXXXXXXXXXX

# ── Sécurité ──────────────────────────────────────────────
# Génère avec : openssl rand -hex 32
CRON_SECRET=remplace_par_une_chaine_aleatoire_longue
WEBHOOK_SECRET=remplace_par_une_autre_chaine_aleatoire

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://autoscorev2.vercel.app
